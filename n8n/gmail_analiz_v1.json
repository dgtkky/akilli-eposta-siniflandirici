    {
      "parameters": {
        "jsCode": "// Gerekli 8 etiketten Gmail'de olmayanları bulur. Her zaman TEK öğe döndürür,\n// böylece eksik etiket olmasa da akış devam eder.\nconst istenen = ['⚠️ Şüpheli', 'İş', 'Fatura-Ödeme', 'Kargo', 'Sosyal Medya', 'Reklam-Bülten', 'Kişisel', 'Diğer'];\nconst mevcut = new Set($input.all().map(i => i.json.name));\nconst eksik = istenen.filter(ad => !mevcut.has(ad));\nreturn [{ json: { eksik } }];"
      },
      "id": "Eksik etiketler",
      "name": "Eksik etiketler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
