    {
      "parameters": {
        "resource": "label",
        "operation": "getAll",
        "returnAll": true
      },
      "id": "Etiketleri yeniden getir",
      "name": "Etiketleri yeniden getir",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1320,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "Vkuq7hTAcSugIbC2",
          "name": "Gmail account"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Gmail Trigger'dan gelen e-postaları API'nin beklediği biçime çevirir.\n// - Uyarı e-postalarımız atlanır (sonsuz döngü koruması, 2. katman).\n// - Düz metin yoksa HTML düz metne çevrilir; bağlantılar \"metin (adres)\" olarak korunur.\n// - Etiket adı -> kimlik haritası her öğeye eklenir.\nconst UYARI_ONEKI = '[Oltalama Uyarısı]';\nconst harita = Object.fromEntries($('Etiketleri yeniden getir').all().map(i => [i.json.name, i.json.id]));\n\nfunction htmlMetin(html) {\n  return String(html || '')\n    .replace(/<(script|style)[\\s\\S]*?<\\/\\1>/gi, ' ')\n    .replace(/<a\\s[^>]*href=[\"']([^\"']+)[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi, '$2 ($1)')\n    .replace(/<br\\s*\\/?>|<\\/(p|div|li|tr|h\\d)>/gi, '\\n')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&amp;/g, '&')\n    .replace(/[ \\t]+/g, ' ').replace(/\\n\\s*\\n+/g, '\\n\\n').trim();\n}\n\nconst sonuc = [];\nfor (const oge of $('Gmail Trigger').all()) {\n  const e = oge.json;\n  const konu = String(e.subject || '');\n  if (konu.startsWith(UYARI_ONEKI)) continue;\n  const metin = (e.text && e.text.trim()) ? e.text : htmlMetin(e.html);\n  sonuc.push({ json: {\n    mesaj_id: e.id,\n    gonderen: (e.from && e.from.text) || '',\n    konu,\n    metin: (metin || '(metin yok)').slice(0, 200000),   // API sınırı\n    etiketler: harita,\n  }});\n}\nreturn sonuc;"
      },
      "id": "E-postaları hazırla",
      "name": "E-postaları hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/analiz",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ gonderen: $json.gonderen, konu: $json.konu, metin: $json.metin }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "FastAPI — analiz",
      "name": "FastAPI — analiz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        300
