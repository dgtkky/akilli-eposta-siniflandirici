      "id": "Şüpheli mi?",
      "name": "Şüpheli mi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Düz metin uyarı e-postası. Bağlantılar ve alan adları etkisizleştirilir (defang):\n// http://kotu.com -> hxxp://kotu[.]com ; Gmail bunları tıklanabilir yapmaz.\nconst a = $('Sonucu birleştir').item.json;\nconst GUVENLI_LISTE_CUMLESI = 'Güvenli listedeki bir adresten geliyor ama içerik şüpheli; adres taklit edilmiş veya hesap ele geçirilmiş olabilir.';\n\nfunction etkisiz(yazi) {\n  return String(yazi ?? '')\n    .replace(/\\b(?:https?:\\/\\/|www\\.)[^\\s\"'<>]+/gi, u => u.replace(/^http/i, 'hxxp').replace(/\\./g, '[.]'))\n    .replace(/\\b(?:[a-z0-9-]+\\.)+[a-z]{2,}\\b/gi, d => d.replace(/\\./g, '[.]'));\n}\n\nlet gerekce = String(a.gerekce || '');\nif (gerekce.startsWith(GUVENLI_LISTE_CUMLESI)) gerekce = gerekce.slice(GUVENLI_LISTE_CUMLESI.length).trim();\n\nconst satirlar = [\n  'Gelen kutunuzdaki bir e-posta ŞÜPHELİ olarak işaretlendi.', '',\n  'Gönderen : ' + etkisiz(a.orijinal_gonderen),\n  'Konu     : ' + etkisiz(a.orijinal_konu),\n  'Tür      : ' + a.tur, '',\n];\nif (a.guvenli_liste_uyarisi) satirlar.push('UYARI: Bu adres güvenli listende ama içerik şüpheli; adres taklit edilmiş veya hesap ele geçirilmiş olabilir.', '');\nsatirlar.push('Gerekçe:', etkisiz(gerekce), '');\nif ((a.isaretler || []).length) {\n  satirlar.push('Bulunan işaretler:');\n  for (const i of a.isaretler) satirlar.push(`- ${i.isaret}: \"${etkisiz(i.ifade)}\"`);\n  satirlar.push('');\n}\nsatirlar.push('Bağlantılara tıklamayın, bilgi veya ödeme göndermeyin.',\n              'E-postaya Gmail\\'de \"⚠️ Şüpheli\" etiketi eklendi.');\n\nconst konuSatiri = etkisiz(a.orijinal_konu).replace(/[\\r\\n]+/g, ' ').slice(0, 120);\nreturn { json: { konu: '[Oltalama Uyarısı] ⚠️ Şüpheli e-posta: ' + konuSatiri, govde: satirlar.join('\\n') } };",
        "mode": "runOnceForEachItem"
      },
      "id": "Uyarıyı hazırla",
      "name": "Uyarıyı hazırla",
      "type": "n8n-nodes-base.code",
