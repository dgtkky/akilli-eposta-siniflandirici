    {
      "parameters": {
        "jsCode": "// API sonucunu e-posta bilgileriyle birleştirir ve eklenecek etiketi seçer.\nconst e = $('E-postaları hazırla').item.json;\nconst a = $json;\nconst etiketAdi = a.karar === 'ŞÜPHELİ' ? '⚠️ Şüpheli' : (a.kategori || 'Diğer');\nconst etiketId = e.etiketler[etiketAdi];\nif (!etiketId) throw new Error('Gmail etiketi bulunamadı: ' + etiketAdi);\nreturn { json: { ...a, mesaj_id: e.mesaj_id, orijinal_gonderen: e.gonderen,\n                 orijinal_konu: e.konu, etiket_adi: etiketAdi, etiket_id: etiketId } };",
        "mode": "runOnceForEachItem"
      },
      "id": "Sonucu birleştir",
      "name": "Sonucu birleştir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ]
    },
